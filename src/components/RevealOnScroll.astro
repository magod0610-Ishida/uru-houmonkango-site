<script>
  // スクロールすると、下から静かにふわっと現れる表示（全ページ共通）
  // ・最初の画面（ページの一番上の欄）は、すぐ見えるように動かさない
  // ・カードや一覧は、1つずつ少しずつ時間をずらして現れる
  // ・「視差効果を減らす」設定の人には、動きを付けない（global.css 側で対応）
  document.documentElement.classList.add('js');

  const isGroup = (el: Element) =>
    el.tagName === 'UL' || el.tagName === 'OL' || el.classList.contains('grid') ||
    [...el.classList].some((c) => c.startsWith('space-y-'));
  const isWrapper = (el: Element) =>
    el.tagName === 'DIV' && el.children.length > 0 && ![...el.childNodes].some((n) => n.nodeType === 3 && n.textContent?.trim());

  const targets: { el: Element; delay: number }[] = [];
  const collect = (parent: Element, depth: number) => {
    [...parent.children].forEach((child) => {
      if (child.getAttribute('aria-hidden') === 'true') return;
      if (isGroup(child) && child.children.length > 1) {
        [...child.children].forEach((item, i) => targets.push({ el: item, delay: (i % 4) * 110 }));
      } else if (isWrapper(child) && depth < 2 && !child.classList.contains('rounded-2xl')) {
        collect(child, depth + 1);
      } else {
        targets.push({ el: child, delay: 0 });
      }
    });
  };
  document.querySelectorAll('main > section:not(:first-child)').forEach((section) => {
    const inner = section.querySelector(':scope > div:not([aria-hidden="true"])');
    if (!inner) return;
    if (isGroup(inner)) {
      [...inner.children].forEach((item, i) => targets.push({ el: item, delay: (i % 4) * 110 }));
    } else {
      collect(inner, 0);
    }
  });

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  targets.forEach(({ el, delay }) => {
    el.setAttribute('data-reveal', '');
    (el as HTMLElement).style.setProperty('--reveal-delay', `${delay}ms`);
    io.observe(el);
  });
</script>
