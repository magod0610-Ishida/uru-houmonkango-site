---
interface Props {
  eyebrow: string;
  title: string;
  light?: boolean;
}

const { eyebrow, title, light = false } = Astro.props;
---

<div class="mb-10 sm:mb-12">
  <span
    class={`inline-block text-xs sm:text-sm font-bold tracking-widest mb-3 px-3 py-1 rounded-full ${
      light ? 'bg-white/10 text-brand-200' : 'bg-brand-50 text-brand-700'
    }`}
  >
    {eyebrow}
  </span>
  <div class="flex items-center gap-2">
    <svg
      viewBox="0 0 24 24"
      class={`w-6 h-6 sm:w-7 sm:h-7 shrink-0 ${light ? 'text-brand-300' : 'text-brand-400'}`}
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 2C7 4 4 8 4 13c0 4 3 7 8 9 5-2 8-5 8-9 0-5-3-9-8-11z" />
      <path d="M12 4v18" />
    </svg>
    <h3 class={`text-2xl sm:text-3xl font-bold ${light ? 'text-white' : 'text-gray-900'}`}>
      {title}
    </h3>
  </div>
  <svg
    viewBox="0 0 96 10"
    class={`mt-3 w-20 sm:w-24 h-2.5 ${light ? 'text-brand-400/60' : 'text-brand-300'}`}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path d="M0 5 Q 6 0, 12 5 T 24 5 T 36 5 T 48 5 T 60 5 T 72 5 T 84 5 T 96 5" stroke-linecap="round" />
  </svg>
</div>
