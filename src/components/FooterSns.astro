---
// フッターに並べるSNSのアイコン（LINE・Instagram・Threads）
// URLが空のものは、公開版には出さない（手元の確認用画面にだけ、仮の形で出る）
import { lineUrl, instagramUrl, threadsUrl } from '../data/site';

const items = [
  {
    label: 'LINE',
    url: lineUrl,
    icon: `<path d="M4 6.5C4 5.1 5.1 4 6.5 4h11C18.9 4 20 5.1 20 6.5v8c0 1.4-1.1 2.5-2.5 2.5H11l-4 3v-3h-.5C5.1 17 4 15.9 4 14.5v-8z" /><path d="M8 9.5v3M11 9.5v3M11 9.5l2.5 3v-3M16 9.5h-1.5v3H16M14.5 11H16" />`,
  },
  {
    label: 'Instagram',
    url: instagramUrl,
    icon: `<rect x="4" y="4" width="16" height="16" rx="4.5" /><circle cx="12" cy="12" r="3.6" /><circle cx="16.8" cy="7.2" r=".6" fill="currentColor" />`,
  },
  {
    label: 'Threads',
    url: threadsUrl,
    icon: `<path d="M16.5 11.2c-.4-2.4-2-3.6-4.3-3.6-2.6 0-4.2 1.9-4.2 4.5 0 2.7 1.7 4.6 4.4 4.6 2.1 0 3.6-1.1 3.6-2.8 0-1.6-1.4-2.5-3.4-2.5-1.5 0-2.4.7-2.4 1.7 0 .9.8 1.5 1.9 1.5 1.9 0 2.9-1.6 2.9-4.1" /><path d="M19.5 12c0 4.6-3 7.5-7.4 7.5S4.5 16.4 4.5 12 7.5 4.5 12.1 4.5c3 0 5.2 1.3 6.4 3.6" />`,
  },
].filter((item) => item.url !== '' || import.meta.env.DEV);
---

{items.length > 0 && (
  <ul class="flex justify-center gap-4 mb-5" aria-label="SNS・LINE">
    {items.map((item) => (
      <li>
        <a
          href={item.url || '#'}
          target={item.url ? '_blank' : undefined}
          rel={item.url ? 'noopener' : undefined}
          class="flex flex-col items-center gap-1 px-2 py-1 text-gray-300 hover:text-white transition-colors"
          aria-label={item.url ? item.label : `${item.label}（URL未設定）`}
        >
          <span class="w-11 h-11 rounded-full border border-gray-600 flex items-center justify-center">
            <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
          </span>
          <span class="text-xs">{item.url ? item.label : `${item.label}（未設定）`}</span>
        </a>
      </li>
    ))}
  </ul>
)}
