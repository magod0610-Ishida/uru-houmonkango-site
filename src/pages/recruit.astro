---
// 採用情報のページ。文章は、代表からいただいた内容（2026-10）を、読みやすく整えたもの。
// 募集職種・勤務時間などの募集要項は、［ここに…］のままの項目は、公開ページには出さない（決まったら、中身を入れると表示される）
import SubPageLayout from '../components/SubPageLayout.astro';
import Button from '../components/Button.astro';
import { email, lineUrl } from '../data/site';
import { ph } from '../lib/ph';

// 募集要項（決まった項目から、［ ］を消して中身を入れる）
const jobs = [
  { label: '募集職種', value: '[ここに募集職種を入れる]' },
  { label: '雇用形態', value: '[常勤・非常勤など]' },
  { label: '勤務時間', value: '[ここに勤務時間を入れる]' },
  { label: '勤務地', value: '[訪問看護ステーション／ルルソア相談室]' },
];
const filledJobs = jobs.filter((j) => !j.value.startsWith('['));

const appeals = [
  {
    title: 'お互いを尊重し合える、|あたたかいチーム',
    text: '私たちの職場では、スタッフ間のコミュニケーションを何よりも大切にしています。お互いの意見を尊重し、困ったときはすぐに相談できるフラットな環境です。ブランクがある方や訪問未経験の方でも、チーム全体で丁寧にフォローするので、安心してスタートできます。',
  },
  {
    title: '利用者さまと、|じっくり向き合える喜び',
    text: '病院や施設とは異なり、利用者さまのご自宅や住み慣れた地域で、お一人おひとりの生活リズムや想いに合わせたケア・相談支援を提供できます。「その人らしい暮らし」を支え、深い信頼関係を築けるのが、この仕事の一番のやりがいです。',
  },
  {
    title: 'プライベートも大切にできる、|柔軟な働き方',
    text: '常勤・非常勤（パート）など、ライフステージやご希望に合わせた働き方を選択できます。残業は少なく、有給休暇も取得しやすい環境を整えています。子育てや家庭、趣味の時間と両立しながら、無理なく長く働き続けられます。',
  },
  {
    title: '共に学び、|成長できる環境',
    text: '「訪問看護ステーション」と「ルルソア相談室」が連携し、多角的な視点から地域福祉に貢献しています。日々の業務を通じて専門性を高められるだけでなく、研修への参加支援など、あなたの「学びたい」「成長したい」という想いをしっかりバックアップします。',
  },
];

// 求める人物像（代表からの例をもとにした文。内容は、代表に確認中）
const persons = ['明るく挨拶ができる方', '相手の話を、じっくり聴ける方'];

const staffGroups = [
  { role: '看護師', detail: '5名（常勤1・非常勤4）' },
  { role: '准看護師', detail: '1名（常勤）' },
  { role: 'ケアマネジャー', detail: '2名（常勤）' },
  { role: 'リハビリ職', detail: '4名（PT常勤1・非常勤3）' },
];

const check = `<svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>`;
---

<SubPageLayout title="採用情報" description="うる訪問看護ステーション・ルルソア相談室の採用情報です。「ありがとう」がダイレクトに届く、訪問看護・相談支援のお仕事です。">
  <!-- ページの見出し -->
  <section class="px-4 sm:px-6 pt-10 pb-12 sm:pt-14 sm:pb-16 bg-[#F1E9D2]">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-gray-600 mb-6"><a href="/" class="inline-block py-2.5 hover:text-brand-700 underline underline-offset-4">トップ</a>　＞　採用情報</p>
      <p class="text-gray-700 font-bold tracking-widest text-xs sm:text-sm mb-3">RECRUIT</p>
      <h1 class="text-[1.75rem] sm:text-4xl font-bold text-gray-900 leading-snug mb-6">採用情報</h1>
      <p class="phrase text-gray-900 text-xl sm:text-2xl font-bold leading-relaxed mb-3" set:html={ph('「ありがとう」が|ダイレクトに届く。')} />
      <p class="phrase text-gray-800 text-base sm:text-lg leading-relaxed font-medium" set:html={ph('訪問看護・相談支援だからこそできる、|深い関わりが|ここにあります。')} />
    </div>
  </section>

  <!-- うるで働く魅力 -->
  <section class="px-4 sm:px-6 py-14 sm:py-20 bg-white">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8">うるで働く魅力</h2>
      <div class="space-y-5">
        {appeals.map((a, i) => (
          <div class="bg-cream rounded-2xl p-6 sm:p-8">
            <p class="text-brand-700 font-bold text-sm tracking-widest mb-2">POINT {i + 1}</p>
            <h3 class="phrase text-xl sm:text-2xl font-bold text-gray-900 mb-3" set:html={ph(a.title)} />
            <p class="text-gray-800 text-base sm:text-lg leading-loose font-medium">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 求める人物像 -->
  <section class="px-4 sm:px-6 py-14 sm:py-20 bg-brand-50">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">求める人物像</h2>
      <p class="text-gray-800 text-base sm:text-lg leading-loose font-medium mb-6">
        技術や経験よりも、まずは、人と向き合う気持ちを大切にしています。
      </p>
      <ul class="grid sm:grid-cols-2 gap-4">
        {persons.map((p) => (
          <li class="flex gap-3 items-start bg-white rounded-2xl p-5 shadow-softer text-gray-900 text-base sm:text-lg font-bold leading-relaxed">
            <span class="shrink-0 mt-1 text-brand-600" set:html={check} />{p}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 募集職種・働き方（中身が入った項目だけ表示） -->
  {filledJobs.length > 0 && (
    <section class="px-4 sm:px-6 py-14 sm:py-20 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8">募集職種・働き方</h2>
        <dl class="text-base sm:text-lg divide-y divide-gray-100 border-y border-gray-100">
          {filledJobs.map((j) => (
            <div class="flex flex-col sm:flex-row gap-1 sm:gap-4 py-4"><dt class="sm:w-28 shrink-0 font-bold text-gray-900">{j.label}</dt><dd class="text-gray-700">{j.value}</dd></div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <!-- いまのスタッフ構成 -->
  <section class="px-4 sm:px-6 py-14 sm:py-20 bg-cream">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8">いまのスタッフ構成</h2>
      <div class="grid grid-cols-2 gap-4">
        {staffGroups.map((g) => (
          <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-softer">
            <p class="font-bold text-gray-900 text-lg mb-1">{g.role}</p>
            <p class="text-gray-700 text-base leading-relaxed font-medium">{g.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 応募・お問い合わせ -->
  <section class="px-4 sm:px-6 py-16 sm:py-20 bg-brand-800 text-white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="phrase text-2xl sm:text-3xl font-bold mb-4" set:html={ph('まずは、|お気軽に|お問い合わせください')} />
      <p class="phrase text-brand-100 text-base sm:text-lg leading-relaxed font-medium mb-8" set:html={ph('職種や働き方について、|見学のご相談も|お待ちしています。')} />
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <Button href={`mailto:${email}`} variant="onDarkSolid">メールで問い合わせる</Button>
        <Button href={lineUrl} variant="onDark">LINEで問い合わせる</Button>
      </div>
    </div>
  </section>
</SubPageLayout>
