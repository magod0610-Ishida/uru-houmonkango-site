---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import { lineUrl } from '../data/site';
import FooterSns from '../components/FooterSns.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import { ph } from '../lib/ph';

// LINE公式アカウントの「友だち追加URL」は、src/data/site.ts で管理（ほかのページと共通）
// 空の間は、本番（公開版）にはLINEのボタンを出さない（手元の確認用画面にだけ出る）
const showLine = lineUrl !== '' || import.meta.env.DEV;

const siteName = 'うる訪問看護ステーション｜ルルソア相談室';
const siteDescription =
  '在宅で介護をしている方（岬町・阪南市・泉南市エリア）へ、訪問看護・ケアプランセンターのサービスをご案内する公式サイトです。';

const navLinks = [
  { href: '/about/', label: 'うるについて' },
  { href: '/houmon-kango/', label: '訪問看護' },
  { href: '/lurusoa/', label: 'ルルソア相談室' },
  { href: '/recruit/', label: '採用情報' },
  { href: '#contact', label: 'お問い合わせ' },
];

// 目的別の入口のカード（トップの最初に置く。詳しい内容は各ページ）
// 絵は仮のアイコン。写真やイラストが決まったら差し替える
const entryCards = [
  {
    href: '/houmon-kango/',
    sub: 'ご自宅で、|看護・リハビリを|受けたい方へ',
    title: '訪問看護|ステーション',
    lead: '看護師や|リハビリスタッフが|ご自宅に伺い、|療養生活を|支えます。',
    bg: 'bg-brand-100',
    iconColor: 'text-brand-700',
    more: 'text-brand-800',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5c0-3 2-5.5 4.5-5.5 1.6 0 2.8.8 3.5 2 .7-1.2 1.9-2 3.5-2 2.5 0 4.5 2.5 4.5 5.5 0 4-4.5 7-8 8.5-3.5-1.5-8-4.5-8-8.5z" /></svg>`,
  },
  {
    href: '/lurusoa/',
    sub: '介護保険・|ケアプランの|ご相談',
    title: 'ルルソア|相談室',
    lead: '介護保険や|暮らしのことを、|ケアマネジャーに|ご相談|いただけます。',
    bg: 'bg-accent-100',
    iconColor: 'text-accent-700',
    more: 'text-[#8F4F16]',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v10H8l-4 4V5z" /><path d="M8 9h8M8 12h5" /></svg>`,
  },
  {
    href: '/recruit/',
    sub: 'うるで|働きたい方へ',
    title: '採用情報',
    lead: '地域で|一緒に働く|仲間を|募集しています。',
    bg: 'bg-[#F1E9D2]',
    iconColor: 'text-gray-700',
    more: 'text-gray-800',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3" /><path d="M3.5 19c.7-3 2.9-5 5.5-5s4.8 2 5.5 5" /><circle cx="17" cy="9" r="2.3" /><path d="M15.5 14.3c.5-.2 1-.3 1.5-.3 2 0 3.6 1.5 4 4" /></svg>`,
  },
];


// 短い紹介に添える事実（詳しくは /about/）
const aboutFacts = [
  { label: '設立', value: '令和3年4月' },
  { label: '対応エリア', value: '岬町・阪南市・泉南市' },
  { label: 'チーム', value: '看護師・ケアマネジャー・リハビリ職' },
];

// 実際にいただいた感想が決まったら、このカードを入れ替えてください
const testimonials = [
  { quote: '[ここにご家族・ご利用者様からいただいた感想を入れる]', name: '[ここにお名前・ご関係を入れる]' },
  { quote: '[ここにご家族・ご利用者様からいただいた感想を入れる]', name: '[ここにお名前・ご関係を入れる]' },
  { quote: '[ここにご家族・ご利用者様からいただいた感想を入れる]', name: '[ここにお名前・ご関係を入れる]' },
];
// 仮の文（[ここに…]）のままの間は、お客様の声の欄をトップに出さない
const showVoice = testimonials.some((t) => !t.quote.startsWith('['));
---

<Layout title={siteName} description={siteDescription}>
  <!-- ヘッダー -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
      <a href="#top" class="flex items-center gap-2 min-w-0 font-bold text-brand-800 leading-snug whitespace-nowrap">
        <img src="/images/logo-leaf.webp" alt="うる ロゴ" class="w-9 h-9 sm:w-10 sm:h-10 object-contain shrink-0" />
        <span class="hidden sm:inline text-lg sm:text-xl">{siteName}</span>
        <span class="sm:hidden text-lg">うる訪問看護</span>
      </a>
      <div class="flex items-center gap-2 shrink-0">
        <Button href="#contact" size="sm" fullWidthMobile={false}>お問い合わせ</Button>
        <!-- スマホ用メニュー（JavaScriptなしで開閉できる） -->
        <details class="lg:hidden relative">
          <summary class="list-none cursor-pointer w-10 h-10 flex items-center justify-center rounded-full border border-gray-200 text-gray-700" aria-label="メニューを開く">
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </summary>
          <nav class="absolute right-0 mt-2 w-56 bg-white border border-gray-100 rounded-2xl shadow-soft p-2 text-base font-medium">
            {navLinks
              .filter((link) => link.href !== '#contact')
              .map((link) => (
                <a href={link.href} class="block px-4 py-2.5 rounded-xl text-gray-700 hover:bg-brand-50 hover:text-brand-700">
                  {link.label}
                </a>
              ))}
          </nav>
        </details>
      </div>
    </div>
    <!-- PC用ナビ（ロゴ行とは別の行にして、すっきり見せる） -->
    <nav class="hidden lg:block border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-6 py-2.5 flex items-center justify-center gap-8 text-base font-medium">
        {navLinks
          .filter((link) => link.href !== '#contact')
          .map((link) => (
            <a href={link.href} class="text-gray-700 hover:text-brand-700 transition-colors whitespace-nowrap">
              {link.label}
            </a>
          ))}
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="relative overflow-hidden px-4 sm:px-6 py-12 sm:py-16 lg:py-20 bg-brand-50">
      <!-- 「うる」の葉っぱロゴ（装飾・背景用、文字の邪魔にならないよう薄く大きく配置） -->
      <img
        src="/images/logo-leaf.webp"
        alt=""
        aria-hidden="true"
        class="pointer-events-none select-none absolute -right-6 -top-6 w-56 h-56 sm:-right-16 sm:-top-20 sm:w-[28rem] sm:h-[28rem] object-contain opacity-20 sm:opacity-15"
      />
      <!-- Clay風の柔らかい円形ぼかし装飾（背景演出、可読性を妨げない極薄opacity） -->
      <div class="pointer-events-none select-none absolute -left-24 bottom-0 w-80 h-80 rounded-full bg-brand-300/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative z-10 max-w-6xl mx-auto grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-16 items-center">
        <div class="text-center lg:text-left">
          <span class="inline-block bg-accent-50 text-[#8F4F16] font-bold tracking-wide text-sm sm:text-base mb-5 px-4 py-1.5 rounded-full">
            岬町・阪南市・泉南市エリア対応
          </span>
          <!-- 改行は、言葉のまとまりの途中で起きないようにする（「ステーショ／ン」のように切れない） -->
          <h1 class="font-black text-[1.6rem] min-[400px]:text-3xl sm:text-4xl lg:text-[2.6rem] xl:text-5xl text-gray-900 leading-relaxed sm:leading-snug mb-6">
            <span class="inline-block">うる訪問看護ステーション</span><span class="inline-block">｜ルルソア相談室</span>
          </h1>
          <p class="phrase text-gray-700 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 mb-8 leading-relaxed font-medium">
            <Fragment set:html={ph('岬町・阪南市・泉南市エリアで、|ご自宅での介護を|頑張っているあなたへ。')} /><br class="hidden sm:block" />
            <Fragment set:html={ph('訪問看護や|ケアプランのこと、|まずは気軽に|お話ししてみませんか？')} />
          </p>
          <div class="flex justify-center lg:justify-start">
            <Button href="#contact">お問い合わせ</Button>
          </div>
        </div>

        <!-- メインビジュアル：訪問看護ステーションの看板（うるのInstagramより。差し替えるときは public/images に置いて src を変える） -->
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div class="absolute -inset-4 bg-gradient-to-br from-brand-200/40 to-accent-100/40 rounded-[2rem] blur-2xl" aria-hidden="true"></div>
          <img
            src="/images/houmon-kango-kanban.jpg"
            alt="うる訪問看護ステーションの看板（TEL 072-447-9247）"
            width="1079"
            height="1080"
            class="relative w-full aspect-[4/3] object-cover object-[center_58%] rounded-lg shadow-soft"
          />
        </div>
      </div>
    </section>

    <!-- ENTRY：目的別の入口（それぞれの専用ページへ） -->
    <section id="entry" class="scroll-mt-20 px-4 sm:px-6 pt-10 pb-16 sm:pt-14 sm:pb-24 bg-white">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-center text-2xl sm:text-3xl font-bold text-gray-900 mb-3 phrase" set:html={ph("ご用件に合わせて、|お選びください")} />
        <p class="text-center text-gray-600 text-base sm:text-lg font-medium mb-10 sm:mb-12 phrase" set:html={ph("それぞれの|くわしいページを|ご覧いただけます。")} />
        <div class="grid md:grid-cols-3 gap-6">
          {entryCards.map((card) => (
            <a href={card.href} class="group flex flex-col rounded-2xl overflow-hidden border border-gray-100 shadow-softer hover:shadow-soft hover:-translate-y-1 transition-all bg-white">
              <div class={`flex flex-col items-center text-center px-6 pt-8 pb-7 ${card.bg}`}>
                <!-- ここにイラストや写真を入れる（今は仮のアイコン） -->
                <div class={`w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-white flex items-center justify-center mb-5 shadow-softer [&_svg]:w-12 [&_svg]:h-12 ${card.iconColor}`} set:html={card.icon} />
                <p class="phrase text-sm font-bold tracking-wide text-gray-600 mb-1" set:html={ph(card.sub)} />
                <h3 class="phrase text-xl sm:text-2xl font-bold text-gray-900 mb-3" set:html={ph(card.title)} />
                <p class="phrase text-gray-800 text-base leading-relaxed font-medium" set:html={ph(card.lead)} />
              </div>
              <span class={`mt-auto flex items-center justify-center gap-2 py-4 font-bold text-base sm:text-lg border-t border-gray-100 ${card.more}`}>
                詳しく見る
                <svg viewBox="0 0 24 24" class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ABOUT（短い紹介。詳しくは /about/「うるについて」） -->
    <section id="about" class="scroll-mt-20 px-4 sm:px-6 py-16 sm:py-24 bg-brand-50">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
          <div>
            <p class="text-brand-700 font-bold tracking-widest text-xs sm:text-sm mb-3">ABOUT</p>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-5">はじめまして、うるです。</h2>
            <p class="phrase text-gray-700 text-base sm:text-lg leading-loose font-medium mb-6">
              <Fragment set:html={ph('令和3年4月に|大阪府岬町で生まれた、|訪問看護ステーションと|ケアプランセンターです。|看護師・ケアマネジャー・リハビリ職が|チームで連携しながら、|住み慣れたまちで|安心して暮らせるよう、|真心をこめたケアを|お届けしています。')} />
            </p>
            <ul class="space-y-2.5 mb-8">
              {aboutFacts.map((f) => (
                <li class="flex gap-3 items-start text-base sm:text-lg">
                  <span class="shrink-0 w-24 font-bold text-gray-900">{f.label}</span>
                  <span class="text-gray-700 font-medium">{f.value}</span>
                </li>
              ))}
            </ul>
            <Button href="/about/" variant="secondary" fullWidthMobile={false}>うるについて詳しく →</Button>
          </div>
          <!-- ここに事業所やスタッフの写真を入れる -->
          <PhotoPlaceholder label="ここに事業所・スタッフの写真を入れる" class="aspect-[4/3]" />
        </div>
      </div>
    </section>

    {showVoice && (
    <!-- VOICE -->
    <section id="voice" class="relative overflow-hidden scroll-mt-20 px-4 sm:px-6 py-20 sm:py-28 bg-brand-50">
      <div class="pointer-events-none select-none absolute -left-16 -bottom-16 w-72 h-72 rounded-full bg-brand-300/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative max-w-5xl mx-auto">
        <SectionHeading eyebrow="VOICE" title="ご利用者様の声" />
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {testimonials.map((t) => (
            <div class="bg-white rounded-2xl shadow-softer p-6 sm:p-7 hover:shadow-soft hover:-translate-y-0.5 transition-all">
              <span class="text-accent-500 text-3xl font-bold leading-none block mb-2" aria-hidden="true">"</span>
              <p class="text-gray-700 text-base sm:text-lg leading-relaxed mb-4 font-medium">{t.quote}</p>
              <p class="text-gray-800 text-base font-bold">{t.name}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- CONTACT -->
    <section id="contact" class="scroll-mt-20 px-4 sm:px-6 py-20 sm:py-28 bg-brand-800 text-white">
      <div class="max-w-5xl mx-auto text-center">
        <div class="inline-block text-left">
          <SectionHeading eyebrow="CONTACT" title="お問い合わせ" light />
        </div>
        <p class="text-brand-100 text-base sm:text-lg max-w-xl mx-auto mb-8 leading-relaxed font-medium">
          サービスに関するご相談、見学のご希望など、<br class="hidden sm:block" />
          お気軽にお問い合わせください。
        </p>

        <div class="grid sm:grid-cols-2 gap-4 max-w-2xl mx-auto mb-8 text-left">
          <div class="bg-white/10 border border-white/20 rounded-2xl p-5 shadow-softer hover:bg-white/15 transition-colors">
            <p class="font-bold text-lg mb-2">訪問看護ステーション</p>
            <p class="text-brand-100 text-base mb-2 leading-relaxed font-medium">
              〒599-0301<br />大阪府泉南郡岬町淡輪566番地の5
            </p>
            <a href="tel:0724479247" class="inline-block py-2 text-white text-base sm:text-lg font-bold underline underline-offset-2">
              TEL 072-447-9247
            </a>
            <p class="text-brand-100 text-base mt-1 font-medium">FAX 072-468-9769</p>
          </div>
          <div class="bg-white/10 border border-white/20 rounded-2xl p-5 shadow-softer hover:bg-white/15 transition-colors">
            <p class="font-bold text-lg mb-2">ケアプランセンター<br />（ルルソア相談室）</p>
            <p class="text-brand-100 text-base mb-2 leading-relaxed font-medium">
              〒590-0526<br />大阪府泉南市男里4丁目7-11-103
            </p>
            <a href="tel:0724841185" class="inline-block py-2 text-white text-base sm:text-lg font-bold underline underline-offset-2">
              TEL 072-484-1185
            </a>
            <p class="text-brand-100 text-base mt-1 font-medium">FAX 072-484-1186</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          {/* お問い合わせフォームのURLが決まったら、この囲みを外して href に貼る
          <Button href="#" variant="onDark">フォームでお問い合わせ</Button>
          */}
          {showLine && <Button href={lineUrl || '#'} variant="onDark">LINEでお問い合わせ</Button>}
          <Button href="mailto:ulu.co.ltd@outlook.com" variant="onDarkSolid">メールでお問い合わせ</Button>
        </div>
        <div class="hidden sm:flex flex-col items-center gap-3 mt-10">
          <img src="/images/line-qr.png" alt="LINE公式アカウントの友だち追加QRコード" width="140" height="140" class="w-36 h-36 bg-white p-2 rounded-xl" />
          <p class="text-brand-100 text-sm font-medium">パソコンで見ている方は、スマホで読み取って友だち追加</p>
        </div>
      </div>
    </section>
  </main>

  <!-- フッター -->
  <footer class="px-4 sm:px-6 py-8 bg-gray-900 text-gray-300 text-center text-sm sm:text-base font-medium">
    <FooterSns />
    <p>&copy; 2026 {siteName}</p>
    <nav class="mt-3 flex flex-wrap justify-center gap-x-6 gap-y-2" aria-label="フッター">
      <a href="/about/" class="inline-block py-2.5 underline underline-offset-4 hover:text-white">うるについて</a>
      <a href="/houmon-kango/" class="inline-block py-2.5 underline underline-offset-4 hover:text-white">訪問看護ステーション</a>
      <a href="/lurusoa/" class="inline-block py-2.5 underline underline-offset-4 hover:text-white">ルルソア相談室</a>
      <a href="/recruit/" class="inline-block py-2.5 underline underline-offset-4 hover:text-white">採用情報</a>
      <a href="/abuse-prevention/" class="inline-block py-2.5 underline underline-offset-4 hover:text-white">利用者への虐待防止に関する指針</a>
    </nav>
    <p class="mt-2 text-xs sm:text-sm text-gray-400">便利屋さんうる（清掃・不用品処分・草刈り等）も運営しております</p>
  </footer>
</Layout>

<script>
  // スマホのメニューは、リンクを押したら自動で閉じる
  document.querySelectorAll('header details a').forEach((a) => {
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'));
  });
</script>

<RevealOnScroll />
