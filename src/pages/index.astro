<script>
  // スマホのメニューは、リンクを押したら自動で閉じる
  document.querySelectorAll('header details a').forEach((a) => {
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'));
  });
  // ファーストビュー以外のセクション内の要素に、スクロール時のフワッと表示を付ける
  document.documentElement.classList.add('js');
  const targets = document.querySelectorAll('main > section:not(:first-child) > div > *, main > section:not(:first-child) > div > div > *');
  const seen = new Set<Element>();
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  targets.forEach((el, i) => {
    if (seen.has(el) || el.closest('[data-reveal]')) return;
    seen.add(el);
    el.setAttribute('data-reveal', '');
    (el as HTMLElement).style.setProperty('--reveal-delay', `${(i % 3) * 80}ms`);
    io.observe(el);
  });
</script>
