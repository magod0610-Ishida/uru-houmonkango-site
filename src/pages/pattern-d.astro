<script>
  // ヘッダー：スクロールしたら濃い緑の背景にする
  const header = document.getElementById('d-header');
  const onScroll = () => header?.classList.toggle('is-solid', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // サービスのタブ切替
  const tabEls = document.querySelectorAll<HTMLButtonElement>('#d-tabs [role="tab"]');
  tabEls.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabEls.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
    });
  });

  // タブは、キーボードの矢印キーでも切り替えられる
  tabEls.forEach((tab, i) => {
    tab.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft' && e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : -1;
      const next = tabEls[(i + dir + tabEls.length) % tabEls.length];
      next.focus();
      next.click();
    });
  });

  // ファーストビュー以外のセクション内の要素に、スクロール時のフワッと表示を付ける（案Aと同じ仕組み）
  document.documentElement.classList.add('js');
  const targets = document.querySelectorAll(
    'main > section:not(:first-child) > div > *, main > section:not(:first-child) > div > div > *, main > section:not(:first-child) ol > li, main > section:not(:first-child) dl > *'
  );
  const seen = new Set<Element>();
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  targets.forEach((el, i) => {
    if (seen.has(el) || el.closest('[data-reveal]') || el.closest('[role="tabpanel"]')) return;
    seen.add(el);
    el.setAttribute('data-reveal', '');
    (el as HTMLElement).style.setProperty('--reveal-delay', `${(i % 3) * 80}ms`);
    io.observe(el);
  });

  // スマホのメニューは、リンクを押したら自動で閉じる
  document.querySelectorAll('header details a').forEach((a) => {
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'));
  });
</script>
