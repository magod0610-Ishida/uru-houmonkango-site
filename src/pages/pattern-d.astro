---
import Layout from '../layouts/Layout.astro';

// 文章・構成は案A（index.astro）と同じ。デザインだけをCodex版の雰囲気に変えた比較用ページ
// LINE公式アカウントの「友だち追加URL」（https://lin.ee/… の形）を、下の '' の中に貼る。
// 空のままの間は、本番（公開版）にはLINEのボタンを出さない（手元の確認用画面にだけ出る）
const lineUrl = 'https://lin.ee/UhIffvJ';
const showLine = lineUrl !== '' || import.meta.env.DEV;

const siteName = 'うる訪問看護ステーション｜ルルソア相談室';
const siteDescription =
  '在宅で介護をしている方（岬町・阪南市・泉南市エリア）へ、訪問看護・ケアプランセンターのサービスをご案内する公式サイトです。（デザイン比較用：パターンD）';

const navLinks = [
  { href: '#about', label: '私たちについて' },
  { href: '#staff', label: 'スタッフ紹介' },
  { href: '#guide', label: 'ご利用の流れ' },
  { href: '#services', label: 'サービス' },
  { href: '#sns', label: 'SNS' },
  { href: '#recruit', label: '採用情報' },
  { href: '#voice', label: 'お客様の声' },
];

const guideSteps = [
  { title: 'お問合せ', text: '電話・フォームからお気軽にご連絡ください。' },
  { title: 'ご相談・お聞き取り', text: '現在の状況やお困りごとを詳しくお伺いします。' },
  { title: 'ケアプラン作成・訪問日程の調整', text: 'ご本人・ご家族に合わせたケアプランを作成し、訪問日程を調整します。' },
  { title: 'サービス開始', text: '実際の訪問看護・ケアプランに基づくサービスがスタートします。' },
  { title: '定期的な見直し・ご相談', text: '状況の変化に合わせて、ケアプランや対応内容を見直します。' },
];

const staffGroups = [
  { role: '看護師', detail: '5名（常勤1・非常勤4）' },
  { role: '准看護師', detail: '1名（常勤）' },
  { role: 'ケアマネジャー', detail: '2名（常勤／主任介護支援専門員1名〈社会福祉士〉・介護支援専門員1名〈介護福祉士〉）' },
  { role: 'リハビリ職', detail: '4名（PT常勤1・非常勤3）' },
];

// スタッフの人数分、このカードを増やしてください
const staffMembers = [
  { name: '[ここに名前を入れる]', role: '看護師', comment: '[ここにひとことコメントを入れる]' },
  { name: '[ここに名前を入れる]', role: 'ケアマネジャー', comment: '[ここにひとことコメントを入れる]' },
  { name: '[ここに名前を入れる]', role: 'リハビリ職', comment: '[ここにひとことコメントを入れる]' },
];

// 実際にいただいた感想が決まったら、このカードを入れ替えてください
const testimonials = [
  { quote: '[ここにご家族・ご利用者様からいただいた感想を入れる]', name: '[ここにお名前・ご関係を入れる]' },
  { quote: '[ここにご家族・ご利用者様からいただいた感想を入れる]', name: '[ここにお名前・ご関係を入れる]' },
  { quote: '[ここにご家族・ご利用者様からいただいた感想を入れる]', name: '[ここにお名前・ご関係を入れる]' },
];
---

<Layout title={`${siteName}（案D）`} description={siteDescription}>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600&display=swap');
    .d-page { font-family: 'Noto Sans JP', sans-serif; }
    .d-page .mincho { font-family: 'Shippori Mincho', 'Noto Serif JP', serif; font-weight: 500; }
    .d-page .eyebrow { letter-spacing: 0.28em; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
    .d-page h1, .d-page h2, .d-page h3, .d-page h4 { font-family: 'Shippori Mincho', 'Noto Serif JP', serif; font-weight: 500; }
    .d-tab[aria-selected='true'] { background: #2b6a60; color: #fff; }
    .d-panel[hidden] { display: none; }
    .d-page a:focus-visible, .d-page button:focus-visible, .d-page summary:focus-visible { outline: 2px solid #8fd0c2; outline-offset: 3px; }
    .d-header { transition: background-color .3s ease; }
    .d-header.is-solid { background: rgba(15, 58, 52, 0.96); }
  </style>

  <div class="d-page bg-[#fafaf8] text-[#12332e] overflow-x-clip">
    <!-- ヘッダー（写真の上に重ねて、スクロールで濃い緑に） -->
    <header id="d-header" class="d-header fixed top-0 inset-x-0 z-50 border-b border-white/20 text-white">
      <div class="max-w-[1280px] mx-auto px-5 sm:px-10 h-20 flex items-center justify-between gap-4">
        <a href="#top" class="flex items-center gap-3 min-w-0">
          <img src="/images/logo-leaf.webp" alt="うる ロゴ" class="w-11 h-11 object-contain shrink-0" />
          <span class="leading-tight">
            <span class="block mincho text-lg sm:text-xl">うる訪問看護ステーション</span>
            <span class="block eyebrow !text-[0.75rem] opacity-90">ルルソア相談室</span>
          </span>
        </a>
        <nav class="hidden xl:flex items-center gap-7 text-sm font-medium">
          {navLinks.map((l) => <a href={l.href} class="hover:opacity-70 transition-opacity whitespace-nowrap">{l.label}</a>)}
          <a href="#contact" class="inline-flex items-center gap-2 border-l border-white/30 pl-7 whitespace-nowrap hover:opacity-70 transition-opacity">お問い合わせ <span aria-hidden="true">→</span></a>
        </nav>
        <details class="xl:hidden relative">
          <summary class="list-none cursor-pointer w-11 h-11 flex items-center justify-center border border-white/50 rounded-full" aria-label="メニューを開く">
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
          </summary>
          <nav class="absolute right-0 mt-3 w-60 bg-[#0f3a34] text-white p-2 text-sm">
            {navLinks.map((l) => <a href={l.href} class="block px-4 py-3 hover:bg-white/10">{l.label}</a>)}
            <a href="#contact" class="block px-4 py-3 hover:bg-white/10 border-t border-white/20">お問い合わせ →</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="top">
      <!-- Hero：全面写真（写真が決まるまでは濃い緑の仮の枠） -->
      <section class="relative min-h-[100svh] flex items-center text-white overflow-hidden bg-[#1c4a44]">
        <!-- ここにトップのメインビジュアル（外観・スタッフ写真など）を入れる。入れたら下のdivを <img> に置き換える -->
        <div class="absolute inset-0 bg-gradient-to-br from-[#0f3a34] via-[#1f5a52] to-[#4f8a7d]" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/45 via-black/20 to-transparent" aria-hidden="true"></div>
        <p class="absolute right-6 sm:right-12 top-28 text-xs tracking-widest text-white/60 border border-white/30 px-3 py-1.5">写真は仮の枠です</p>
        <div class="relative max-w-[1280px] mx-auto w-full px-5 sm:px-10 pt-28 pb-32">
          <p class="eyebrow mb-8">岬町・阪南市・泉南市エリア対応</p>
          <h1 class="mincho text-[2.2rem] sm:text-5xl lg:text-[4.2rem] leading-[1.5] mb-10">
            うる訪問看護ステーション<br />｜ルルソア相談室
          </h1>
          <p class="mincho text-base sm:text-xl leading-loose mb-12 text-white/95">
            岬町・阪南市・泉南市エリアで、ご自宅での介護を頑張っているあなたへ。<br />
            訪問看護やケアプランのこと、まずは気軽にお話ししてみませんか？
          </p>
          <div class="flex flex-col sm:flex-row gap-4 max-w-2xl">
            <a href="#contact" class="flex-1 flex items-center justify-between gap-4 border border-white/60 px-6 py-5 hover:bg-white hover:text-[#0f3a34] transition-colors">
              <span><span class="block font-bold">訪問看護・ケアプランをご検討の方へ</span><span class="block text-sm opacity-80 mt-1">お問い合わせはこちら</span></span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="#recruit" class="flex-1 flex items-center justify-between gap-4 border border-white/60 px-6 py-5 hover:bg-white hover:text-[#0f3a34] transition-colors">
              <span><span class="block font-bold">採用情報（求人）をお探しの方へ</span><span class="block text-sm opacity-80 mt-1">採用情報を見る</span></span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <p class="absolute left-5 sm:left-10 bottom-8 eyebrow !text-[0.75rem]">設立　令和3年4月〜</p>
        <p class="hidden sm:block absolute right-10 bottom-8 eyebrow !text-[0.75rem] text-white/80">SCROLL ↓</p>
      </section>

      <!-- ABOUT -->
      <section id="about" class="scroll-mt-20 px-5 sm:px-10 py-24 sm:py-32">
        <div class="max-w-[1100px] mx-auto">
          <p class="eyebrow text-[#2b6a60] mb-6">ABOUT</p>
          <h2 class="text-[2rem] sm:text-5xl leading-[1.6] mb-16">事業所について</h2>
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start mb-20">
            <div>
              <p class="mincho text-xl sm:text-2xl mb-8">はじめまして、うるです。</p>
              <div class="leading-[2.1] text-base sm:text-[1.05rem] font-medium space-y-6">
                <p>Ulu.co.ltd株式会社は、令和3年4月に大阪府岬町で生まれた、訪問看護ステーションとケアプランセンターです。</p>
                <p>「うる」はハワイの言葉で木の名前。繁栄と成長を意味していて、地域のみなさんとともに育っていきたいという思いを込めて名付けました。</p>
                <p>看護師・ケアマネジャー・リハビリ職がチームで連携しながら、岬町・阪南市・泉南市エリアで、住み慣れたまちで安心して暮らせるよう、ひとりひとりに真心をこめたケアをお届けしています。</p>
                <p class="border-l border-[#2b6a60] pl-5 text-[#2b6a60]">岬町は「日本の夕陽百選」にも選ばれた、美しい夕陽が見られるまち。そんな住み慣れた地域で、これからも安心して暮らし続けられるように。</p>
              </div>
              <dl class="mt-12 text-base border-t border-[#d9ddd9]">
                <div class="flex gap-4 py-4 border-b border-[#d9ddd9]"><dt class="w-24 shrink-0 font-bold">会社名</dt><dd>Ulu.co.ltd株式会社</dd></div>
                <div class="flex gap-4 py-4 border-b border-[#d9ddd9]"><dt class="w-24 shrink-0 font-bold">施設名</dt><dd>{siteName}</dd></div>
                <div class="flex gap-4 py-4 border-b border-[#d9ddd9]"><dt class="w-24 shrink-0 font-bold">対応エリア</dt><dd>岬町・阪南市・泉南市</dd></div>
                <div class="flex gap-4 py-4 border-b border-[#d9ddd9]"><dt class="w-24 shrink-0 font-bold">創業</dt><dd>令和3年4月</dd></div>
                <div class="flex gap-4 py-4 border-b border-[#d9ddd9]"><dt class="w-24 shrink-0 font-bold">代表者</dt><dd>代表取締役　木堂 功</dd></div>
                <div class="flex gap-4 py-4 border-b border-[#d9ddd9]"><dt class="w-24 shrink-0 font-bold">営業時間</dt><dd>訪問看護ステーション　9:00〜18:00<br />ケアプランセンター（ルルソア相談室）　9:00〜17:00</dd></div>
                <div class="flex gap-4 py-4 border-b border-[#d9ddd9]"><dt class="w-24 shrink-0 font-bold">定休日</dt><dd>土日祝、8月13日〜15日、12月30日〜1月3日</dd></div>
              </dl>
            </div>
            <!-- ここに事業所やスタッフの写真を入れる -->
            <div class="aspect-[4/3] bg-gradient-to-br from-[#dcebe5] to-[#b9d3c9] flex items-center justify-center text-sm text-[#2b6a60] text-center px-4">ここに事業所・スタッフの写真を入れる</div>
          </div>

          <div class="bg-[#1a4e47] text-white px-6 sm:px-14 py-12 sm:py-16 mb-20">
            <p class="eyebrow text-white/70 mb-6">MESSAGE</p>
            <h3 class="text-2xl sm:text-3xl mb-6">代表からのご挨拶</h3>
            <p class="leading-[2.1] text-white/90 mb-6">はじめまして、私たちは「いつでも、いつまでも、自分らしく前を向いて」暮らせるよう支えるパートナーです。地域の皆様に信頼され、愛される場所を目指して、スタッフ一同まごころ込めて歩んでまいります。</p>
            <p class="font-bold">代表取締役　木堂 功</p>
          </div>

          <h3 class="text-2xl sm:text-3xl mb-8">スタッフ構成</h3>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 border-t border-[#d9ddd9]">
            {staffGroups.map((g) => (
              <div class="py-7 border-b border-[#d9ddd9]">
                <p class="font-bold text-lg mb-2">{g.role}</p>
                <p class="text-base leading-relaxed text-gray-700">{g.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- STAFF -->
      <section id="staff" class="scroll-mt-20 bg-[#edf5f1] px-5 sm:px-10 py-24 sm:py-32">
        <div class="max-w-[1100px] mx-auto">
          <p class="eyebrow text-[#2b6a60] mb-6">STAFF</p>
          <h2 class="text-[2rem] sm:text-5xl leading-[1.6] mb-16">スタッフ紹介</h2>
          <!-- スタッフの人数分、staffMembers を増やしてください -->
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-14">
            {staffMembers.map((m) => (
              <div>
                <!-- ここにスタッフの写真を入れる -->
                <div class="aspect-[4/5] bg-gradient-to-br from-[#dcebe5] to-[#b9d3c9] mb-6 flex items-center justify-center text-xs text-[#2b6a60]">スタッフの写真</div>
                <p class="mincho text-xl mb-1">{m.name}</p>
                <p class="text-sm text-[#2b6a60] font-bold mb-3">{m.role}</p>
                <p class="text-base leading-[2] text-gray-700">{m.comment}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- GUIDE（濃い緑・連番STEP） -->
      <section id="guide" class="scroll-mt-20 bg-[#1a4e47] text-white px-5 sm:px-10 py-24 sm:py-32">
        <div class="max-w-[1200px] mx-auto grid lg:grid-cols-[0.8fr_1.2fr] gap-14 lg:gap-24">
          <div>
            <p class="eyebrow text-white/70 mb-6">GUIDE</p>
            <h2 class="text-[2rem] sm:text-5xl leading-[1.55]">ご利用の流れ</h2>
          </div>
          <ol class="border-t border-white/30">
            {guideSteps.map((s, i) => (
              <li class="grid grid-cols-[3.5rem_1fr] sm:grid-cols-[6rem_1fr] gap-2 py-8 border-b border-white/30">
                <span class="eyebrow !tracking-[0.2em] pt-2 text-white/80">STEP {i + 1}</span>
                <div>
                  <h3 class="text-xl sm:text-2xl mb-3">{s.title}</h3>
                  <p class="text-base leading-relaxed text-white/90">{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- SERVICES（タブ切替） -->
      <section id="services" class="scroll-mt-20 px-5 sm:px-10 py-24 sm:py-32">
        <div class="max-w-[1200px] mx-auto">
          <p class="eyebrow text-[#2b6a60] mb-6">SERVICES</p>
          <h2 class="text-[2rem] sm:text-5xl leading-[1.6] mb-16">サービス内容</h2>

          <div class="border-t border-[#d9ddd9] grid lg:grid-cols-[0.34fr_0.66fr]" id="d-tabs">
            <div role="tablist" class="flex lg:flex-col lg:border-r border-[#d9ddd9]">
              <button type="button" role="tab" id="tab-nursing" aria-controls="panel-nursing" aria-selected="true" class="d-tab flex-1 lg:flex-none text-left flex items-center gap-4 sm:gap-6 px-5 sm:px-12 py-6 sm:py-9 text-base sm:text-lg font-medium transition-colors"><span class="text-xs opacity-80">01</span>訪問看護ステーション</button>
              <button type="button" role="tab" id="tab-care" aria-controls="panel-care" aria-selected="false" class="d-tab flex-1 lg:flex-none text-left flex items-center gap-4 sm:gap-6 px-5 sm:px-12 py-6 sm:py-9 text-base sm:text-lg font-medium transition-colors"><span class="text-xs opacity-80">02</span>ケアプランセンター（ルルソア）</button>
            </div>
            <div>
              <div role="tabpanel" id="panel-nursing" aria-labelledby="tab-nursing" class="d-panel lg:px-16 py-10 lg:py-16">
                <p class="eyebrow text-[#2b6a60] mb-8 !font-medium">VISITING NURSING</p>
                <h3 class="text-[1.4rem] sm:text-3xl leading-[1.8] mb-12">「私達は、住み慣れた地域で安心して生活できるよう、ご利用者様、ご家族様に寄り添い、真心をこめた看護をお届けします」</h3>
                <div class="grid sm:grid-cols-2 gap-x-10">
                  <div class="border-t border-[#d9ddd9] py-7">
                    <p class="font-bold mb-4">対応してきた主なケース</p>
                    <ul class="text-base text-gray-700 leading-[1.9] list-disc list-inside space-y-1">
                      <li>日常的な健康管理・内服管理</li>
                      <li>認知症や精神疾患があり、自宅療養に不安のある方</li>
                      <li>がん末期など終末期で、ご自宅での緩和ケアを希望される方</li>
                      <li>退院直後で、集中的な医療ケアやリハビリが必要な方</li>
                    </ul>
                  </div>
                  <div class="border-t border-[#d9ddd9] py-7">
                    <p class="font-bold mb-4">看取りへの対応</p>
                    <ul class="text-base text-gray-700 leading-[1.9] list-disc list-inside space-y-1">
                      <li>24時間365日の緊急訪問体制</li>
                      <li>医師・ご家族様と密に連携した、身体的な緩和ケア</li>
                      <li>ご家族様の心のケアにも寄り添う看取り</li>
                    </ul>
                  </div>
                  <div class="border-t border-[#d9ddd9] py-7 sm:col-span-2">
                    <p class="font-bold mb-4">対応実績の多い分野</p>
                    <ul class="text-base text-gray-700 leading-[1.9] list-disc list-inside space-y-1">
                      <li>医療依存度の高い方：胃瘻（いろう）、中心静脈栄養（IVH）、慢性閉塞性肺疾患、褥瘡（床ずれ）処置 など</li>
                      <li>難病（特定疾患）：パーキンソン病、後天性赤芽球癆 の療養支援</li>
                    </ul>
                  </div>
                </div>
                <p class="mincho text-base sm:text-lg leading-[2] mt-6 pt-8 border-t border-[#d9ddd9]">リハビリスタッフもいるので、住み慣れた自宅で生活に特化したリハビリテーションも提供できます。</p>
              </div>

              <div role="tabpanel" id="panel-care" aria-labelledby="tab-care" hidden class="d-panel lg:px-16 py-10 lg:py-16">
                <p class="eyebrow text-[#2b6a60] mb-4 !font-medium">CARE PLAN CENTER</p>
                <p class="text-sm font-bold text-gray-600 mb-8">居宅介護支援</p>
                <h3 class="text-[1.4rem] sm:text-3xl leading-[1.8] mb-12">「人に寄り添い、心に寄り添うケアを大切にしています。穏やかな時間の中で、その人らしい笑顔や想いを見つめ、もう一度、自分らしく羽ばたける日々を支えます。」</h3>
                <!-- ここにケアプランセンターサービスの詳細説明を入れる -->
                <p class="border-t border-[#d9ddd9] pt-8 text-base leading-[2] text-gray-700">[ここにケアプランセンターサービスの詳細（ケアプラン作成・相談内容など）を入れる]</p>
              </div>
            </div>
          </div>
          <p class="text-sm mt-10 text-gray-600">対応エリア：岬町・阪南市・泉南市</p>
        </div>
      </section>

      <!-- SNS -->
      <section id="sns" class="scroll-mt-20 bg-[#edf5f1] px-5 sm:px-10 py-24 sm:py-28">
        <div class="max-w-[1100px] mx-auto">
          <p class="eyebrow text-[#2b6a60] mb-6">SNS</p>
          <h2 class="text-[2rem] sm:text-5xl leading-[1.6] mb-12">SNS・関連リンク</h2>
          <div class="flex flex-wrap gap-x-12 gap-y-6">
            <!-- ここにInstagramの実際のURLを入れる -->
            <a href="#" class="inline-flex items-center gap-8 border-b border-[#12332e] pb-4 hover:opacity-70 transition-opacity">Instagram（ここにURLを入れる） <span aria-hidden="true">↗</span></a>
            <!-- ここにThreadsの実際のURLを入れる -->
